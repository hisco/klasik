{
  "name": "klasik",
  "version": "2.0.9",
  "description": "TypeScript code generator from OpenAPI/CRD/JSON Schema - rebuilt from ground up with AST-based generation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "klasik": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "templates/",
    "docs/",
    "demo-output/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "openapi",
    "typescript",
    "code-generator",
    "ast",
    "kubernetes",
    "crd",
    "json-schema"
  ],
  "author": "hisco",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "js-yaml": "^4.1.0",
    "mustache": "^4.2.0",
    "ora": "^5.4.1",
    "ts-morph": "^21.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mustache": "^4.2.0",
    "@types/node": "^20.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "jest": "^29.5.0",
    "reflect-metadata": "^0.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
