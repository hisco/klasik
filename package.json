{
  "name": "klasik",
  "version": "2.5.1",
  "description": "TypeScript code generator from OpenAPI/CRD/JSON Schema/Go structs - rebuilt from ground up with AST-based generation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "klasik": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "!dist/__tests__/",
    "templates/",
    "tools/go-schema-gen/*.go",
    "tools/go-schema-gen/*.sh",
    "tools/go-schema-gen/*.md",
    "tools/go-schema-gen/go.mod",
    "tools/go-schema-gen/go.sum",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:go && tsc",
    "build:go": "cd tools/go-schema-gen && ./build.sh || echo 'Warning: Go tool build failed. Go generation will not be available.'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "openapi",
    "typescript",
    "code-generator",
    "ast",
    "kubernetes",
    "crd",
    "json-schema"
  ],
  "author": "hisco",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "js-yaml": "^4.1.0",
    "mustache": "^4.2.0",
    "ora": "^5.4.1",
    "swagger2openapi": "^7.0.8",
    "ts-morph": "^21.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mustache": "^4.2.0",
    "@types/node": "^20.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "jest": "^29.5.0",
    "reflect-metadata": "^0.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
